############################
# Server
############################
HOST=0.0.0.0
PORT=8088

############################
# Auth API entrante
############################
# Plusieurs tokens possibles, séparés par virgule
INBOUND_API_KEYS='change-me'

############################
# Upstream OpenAI-compatible
############################
UPSTREAM_BASE_URL='http://127.0.0.1:8000/v1'
UPSTREAM_API_KEY=''

############################
# Privacy Filter
############################
PRIVACY_MODEL_ID='openai/privacy-filter'

# auto | cuda | cpu
DEVICE=auto

# fp32 | bf16 | fp16 | auto
TORCH_DTYPE=auto

# Remplacer aussi la réponse JSON LLM avant retour client.
# Par défaut true : entrées et réponses sont filtrées.
# Avec true, chat/completions et completions acceptent stream=true :
# la réponse complète est filtrée puis renvoyée en SSE (premier texte retardé).
# Avec false, le flux amont est relayé directement ; seules les entrées sont filtrées.
#FILTER_OUTPUT=true

# Décharge le modèle de la RAM après N secondes d'inactivité (0 = jamais).
MODEL_IDLE_UNLOAD_SECONDS=300

# Inférence dans un thread dédié ; limite incluant le travail actif et en attente.
# Au-delà, HTTP 503 avec Retry-After: 1. Aucun contournement du filtrage.
#INFERENCE_MAX_PENDING=8

# Lots de textes distincts dans une même requête, sans cache entre utilisateurs.
# Réduire à 1 si la mémoire GPU est limitée ; repli automatique à 1 sans token de padding.
#INFERENCE_BATCH_SIZE=4
# Budget cumulé de caractères par lot ; une chaîne plus longue est traitée seule.
#INFERENCE_BATCH_MAX_CHARS=32768

# Pool HTTP partagé par worker, sans conservation des cookies amont.
#UPSTREAM_MAX_CONNECTIONS=100
#UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20

# Score minimum pour accepter une entité détectée.
#MIN_ENTITY_SCORE=0.50

# Limite par chaîne filtrable : dépassement refusé en HTTP 413.
#MAX_STRING_CHARS=200000

############################
# Redaction
############################
# Placeholders stables par requête :
# email identique => même [PRIVATE_EMAIL_1]
PLACEHOLDER_STYLE=typed_index

# Clés JSON à ne pas filtrer.
#SKIP_JSON_KEYS='model,role,type,stream,temperature,max_tokens,top_p,tools,tool_choice,name'

############################
# Metrics
############################
#METRICS_REQUIRE_AUTH=true

############################
# Runtime
############################
#LOG_LEVEL=info
#HF_HOME=/data/huggingface
#TRANSFORMERS_CACHE=/data/huggingface
